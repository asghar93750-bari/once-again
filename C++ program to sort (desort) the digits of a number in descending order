#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int a;
    cin >> a;

    int temp = a;
    int j = 0;

    // Count digits
    while (temp != 0) {
        j++;
        temp /= 10;
    }

    int arr[j];

    for (int i = 0; i < j; i++) {
        arr[i] = a % 10;
        a /= 10;
    }

  
    sort(arr, arr + j, greater<int>());

    int r = 0;
    for (int i = 0; i < j; i++) {
        r = r * 10 + arr[i];
    }

    cout << "Desorted (Descending) number: " << r;

    return 0;
}
