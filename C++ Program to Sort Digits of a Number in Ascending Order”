#include <iostream>
#include <algorithm>
using namespace std;
int main()
{
    int r = 0;
    int a;
    cin >> a;
    int j;
    int temp = a;
    for (j = 1; temp != 0; j++)
    {
        temp /= 10;
    }
    int arr[j];

    for (int i = 0; i < j; i++)
    {
        arr[i] = a % 10;
        a /= 10;
    }
    sort(arr, arr + j - 1);
    cout << "The sorted array is: ";
    for (int i = 0; i < j - 1; i++)
    {
        r = r * 10 + arr[i];
    }
    cout << r;
}
